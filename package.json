{
  "name": "kakeflow",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "predev": "npm run paddleocr:stage",
    "dev": "vite",
    "build": "npm run paddleocr:stage && tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:codemod": "node scripts/localize-tsx.mjs",
    "i18n:generate": "node scripts/generate-ui-translations.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "desktop:build:mac": "npm run ocr:verify && npm run paddleocr:verify && APPLE_SIGNING_IDENTITY=- tauri build --bundles app",
    "desktop:build:mac:dmg": "npm run ocr:verify && npm run paddleocr:verify && APPLE_SIGNING_IDENTITY=- tauri build --bundles dmg",
    "desktop:build:mac:ci": "npm run desktop:build:mac:dmg && npm run desktop:build:mac",
    "desktop:build:windows": "npm run ocr:verify && npm run paddleocr:verify && tauri build --bundles nsis",
    "desktop:release": "tauri build",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "test:packaged": "node scripts/packaged-app-smoke.mjs",
    "test:dmg": "node scripts/dmg-install-smoke.mjs",
    "test:windows-installer": "node scripts/windows-installer-smoke.mjs",
    "ocr:stage:mac": "bash scripts/stage-ocr-resources-macos.sh",
    "ocr:stage:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-ocr-resources-windows.ps1",
    "ocr:verify": "node scripts/verify-ocr-resources.mjs",
    "paddleocr:stage": "node scripts/stage-paddleocr-resources.mjs",
    "paddleocr:verify": "node scripts/stage-paddleocr-resources.mjs --verify-only",
    "check:update-channel": "node scripts/check-update-channel.mjs",
    "release:update:manifest": "node scripts/build-update-manifest.mjs",
    "landing:demo": "node scripts/build-landing-demo.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "relay:start": "node relay-service/start.mjs",
    "relay:test": "node --test relay-service/server.test.mjs",
    "capture:uploader": "node relay-service/reference-capture-uploader/start.mjs",
    "capture:test": "node --test relay-service/reference-capture-uploader/*.test.mjs"
  },
  "dependencies": {
    "@paddleocr/paddleocr-js": "^0.4.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "postal-mime": "^2.7.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^9.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^26.1.0",
    "sharp": "^0.34.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
